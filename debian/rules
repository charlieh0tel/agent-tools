#!/usr/bin/make -f
# A single stdlib-only script: install it directly rather than through
# pybuild, so the package carries no Python packaging machinery.

%:
	dh $@

override_dh_auto_install:
	install -D -m 0755 agent_ps.py debian/agent-tools/usr/bin/agent-ps

override_dh_auto_test:
	python3 -m pytest tests
